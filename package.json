{
  "name": "cozio",
  "private": true,
  "sideEffects": false,
  "version": "2026.4.8",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev --port 3000",
    "dev:e2e": "CLOUDFLARE_ENV=e2e react-router dev --port 3100 --strictPort",
    "preview": "npm run build && vite preview",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "format": "prettier --write .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "codegen": "graphql-codegen --config codegen.ts && react-router typegen",
    "deploy": "npm run build && wrangler deploy",
    "store:check": "node scripts/check-store.mjs",
    "theme:check": "cd '{AppName}' && npx -y @shopify/cli@3.93.2 theme check",
    "theme:preview": "node scripts/theme-preview/server.mjs",
    "theme:package": "cd '{AppName}' && npx -y @shopify/cli@3.93.2 theme package"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@shopify/hydrogen-react": "2026.4.4",
    "graphql": "^16.10.0",
    "isbot": "^5.1.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "1.65.0",
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@graphql-codegen/cli": "5.0.2",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "7.18.4",
    "@react-router/fs-routes": "7.18.4",
    "@shopify/graphql-codegen": "0.0.2",
    "@shopify/prettier-config": "^1.1.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "graphql-config": "^5.0.3",
    "jsdom": "29.1.1",
    "liquidjs": "^10.30.0",
    "node-html-parser": "^9.0.5",
    "prettier": "^3.4.2",
    "typescript": "^5.9.2",
    "vite": "^8.0.1",
    "vitest": "^5.0.5",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": "^22 || ^24"
  }
}
