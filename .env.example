# Copy to .env (never commit .env). Values come from your Shopify store.
# Easiest: `npx shopify hydrogen link` then `npx shopify hydrogen env pull`.
SESSION_SECRET=replace-with-a-long-random-string
PUBLIC_STORE_DOMAIN=ynvg9n-mw.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN=
PUBLIC_STOREFRONT_ID=
PUBLIC_CHECKOUT_DOMAIN=
# Customer Account API (only if using /account)
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_URL=
SHOP_ID=

# --- Mellow storefront options ---------------------------------------------
# Development only: serve the Mellow demo catalog from an in-memory mock of the
# Storefront API (no Shopify store needed). Ignored by production builds.
# Remove or set to false once the store above is linked. In mock mode give
# PUBLIC_STOREFRONT_API_TOKEN any 32-character placeholder (for example
# mockmockmockmockmockmockmockmock): Hydrogen logs a console error for other
# lengths. tests/e2e/e2e.env is a ready-made mock-mode environment.
MOCK_STOREFRONT=false
# Optional: newsletter signups are POSTed as JSON ({email, source}) to this URL
# (Shopify Flow, Klaviyo, Zapier …). Without it the form reports that the
# integration is not connected.
NEWSLETTER_WEBHOOK_URL=
